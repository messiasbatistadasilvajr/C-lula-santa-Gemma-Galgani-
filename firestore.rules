rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'messiasbjunior76@gmail.com' ||
        request.auth.token.email == 'shcelsantagemmagalganipql@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isFormadorOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'formador'])
      );
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // POSTS COLLECTION & COMMENTS (Mural comunitário acessível a todos os membros da célula)
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    // PRAYERS COLLECTION (Intercessão da célula acessível mesmo sem login Google)
    match /prayers/{prayerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // EVENTS & AGENDA
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // CHAT MESSAGES
    match /chats/{channelId}/messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // NOTICES (Mural de Avisos)
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // CANCIONEIRO (SONGS)
    match /songs/{songId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // SCALES & ROTEIRO
    match /scales/{scaleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // DIZIFY - DONORS (MEMBROS CONTRIBUINTES & ANIVERSÁRIOS)
    match /donors/{donorId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // DIZIFY - CAMPAIGNS (CAMPANHAS DA CÉLULA)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // DIZIFY - DONATIONS (HISTÓRICO DE OFERTAS E DOAÇÕES PIX)
    match /donations/{donationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // GALERIA DE FOTOS E ÁLBUNS DA CÉLULA
    match /albums/{albumId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Global Catch-all fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
