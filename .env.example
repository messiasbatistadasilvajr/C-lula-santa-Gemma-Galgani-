# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADOPAGO_ACCESS_TOKEN: Token de produção/teste do Mercado Pago para geração de PIX dinâmico
MERCADOPAGO_ACCESS_TOKEN=""

# ASAAS_API_KEY: Chave de API do Asaas (alternativa ao Mercado Pago para PIX)
ASAAS_API_KEY=""

# PIX_STATIC_KEY: Chave PIX da Célula Santa Gemma Galgani (fallback EMVCo BRCode dinâmico)
PIX_STATIC_KEY="shcelsantagemmagalganipql@gmail.com"
PIX_MERCHANT_NAME="CELULA SANTA GEMMA"
PIX_MERCHANT_CITY="SAO PAULO"

# WHATSAPP_API_URL: Endpoint da API de WhatsApp (Evolution API / Z-API / Meta Cloud API)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_INSTANCE_NAME="celula_santa_gemma"

